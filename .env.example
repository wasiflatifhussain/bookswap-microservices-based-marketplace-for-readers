# database
DB_HOST=<POSTGRES_HOST>
DB_PORT=<POSTGRES_PORT:5432>
DB_USERNAME=<POSTGRES_USERNAME>
DB_PASSWORD=<POSTGRES_PASSWORD>

# kafka
KAFKA_BOOTSTRAP_SERVERS=<KAFKA:9092>

# firebase
FIREBASE_ISSUER_URI=https://securetoken.google.com/<FIREBASE_PROJECT_ID>

# media service
AWS_ACCESS_KEY=<AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_REGION=<AWS_REGION>
S3_BUCKET_NAME=<S3_BUCKET_NAME>

# valuation service
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
MEDIA_SERVICE_BASE_URL=http://media-service:8082/api/media

# notification service
REDIS_HOST=redis
REDIS_PORT=6379

# email service
RESEND_API_KEY=<YOUR_RESEND_API_KEY>

# backend-for-frontend
CATALOG_SERVICE_URL=http://catalog-service:8081
MEDIA_SERVICE_URL=http://media-service:8082
WALLET_SERVICE_URL=http://wallet-service:8084
SWAP_SERVICE_URL=http://swap-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086
HTTP_TIMEOUT_MS=2000
MAX_IN_MEMORY_MB=16